APP_NAME="Micro Projects"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8023
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Dedicated synthetic development database; use separate migration credentials.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=micro_projects_local
DB_USERNAME=micro_projects_web_local
DB_PASSWORD=

# M4.4 national number check of DISC/F2F through a read-only user (see config/national_check.php)
NATIONAL_CHECK_ENABLED=false
NATIONAL_CHECK_HOST=127.0.0.1
NATIONAL_CHECK_PORT=3306
NATIONAL_CHECK_USERNAME=
NATIONAL_CHECK_PASSWORD=

# Login/project pages require MySQL. Sessions/cache need no external service.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local
VITE_APP_NAME="${APP_NAME}"

# Reading an identity document from an attachment (staff approve every value beside the image).
# ID_READER_DRIVER: tesseract (free, local), ollama (free, local vision model) or claude (paid cloud model). Off until the engine is set up.
ID_READER_DRIVER=claude
ID_READER_PASSES=2
# claude: the key (the image is sent to the service only when staff press "read") and a daily limit per account
ANTHROPIC_API_KEY=
ID_READER_MODEL=claude-sonnet-5-5
ID_READER_DAILY_LIMIT=60
# ollama: ollama pull qwen2.5vl:7b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
# tesseract: with the Arabic data (ara); PDFTOPPM_BIN (Poppler) only for PDF scans
TESSERACT_BIN=tesseract
TESSERACT_LANG=ara+eng
# Folder with ara.traineddata when it is not in Tesseract's own tessdata folder (optional)
TESSERACT_DATA=
PDFTOPPM_BIN=pdftoppm
